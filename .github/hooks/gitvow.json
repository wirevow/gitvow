{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "gitvow hook --agent copilot sessionStart",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "gitvow hook --agent copilot preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "gitvow hook --agent copilot postToolUse",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "gitvow hook --agent copilot sessionEnd",
        "timeoutSec": 30
      }
    ]
  }
}