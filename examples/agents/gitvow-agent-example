#!/usr/bin/env python3
"""Example external gitvow adapter for a fictional agent whose hooks are beforeTool / afterTool / start / end
and whose payloads use `sid`, `tool`, `args`, `dir`. Copy, rename to gitvow-agent-<name>, change the three functions."""

import json
import sys

EVENTS = {"start": "SessionStart", "beforeTool": "PreToolUse", "afterTool": "PostToolUse", "end": "Stop"}
TOOLS = {"sh": "Bash", "edit": "Edit", "write": "Write"}


def info():
    return {
        "protocol": 1,
        "name": "example",
        "events": list(EVENTS),
        "install": {
            "user_file": ".example-agent/hooks.json",
            "repo_file": ".example-agent/hooks.json",
            "format": "json",
            "version_key": "version",
            "entries": {ev: [{"command": f"__GITVOW__ hook --agent example {ev}"}] for ev in EVENTS},
        },
    }


def normalize(req):
    ev, p = req.get("event"), req.get("payload") or {}
    gv = EVENTS.get(ev)
    if not gv:
        return {"calls": []}
    base = {"session_id": p.get("sid", ""), "transcript_path": p.get("log", ""), "cwd": p.get("dir", ""), "hook_event_name": gv}
    if gv in ("SessionStart", "Stop"):
        return {"calls": [{"event": gv, "payload": base}]}
    tool = TOOLS.get(p.get("tool", ""), p.get("tool", ""))
    args = p.get("args") or {}
    if tool == "Bash":
        inp = {"command": args.get("cmd", "")}
    else:
        inp = {"file_path": args.get("path", ""), "old_string": args.get("before", ""), "new_string": args.get("after", ""), "content": args.get("text", "")}
    return {"calls": [{"event": gv, "payload": {**base, "tool_name": tool, "tool_input": inp}}]}


def respond(req):
    code, msg = req.get("code", 0), req.get("message", "")
    if code == 2:
        verdict = "deny" if msg.startswith("BLOCKED") else "ask"
        return {"exit_code": 0, "stdout": json.dumps({"verdict": verdict, "why": msg}), "stderr": ""}
    return {"exit_code": 0, "stdout": json.dumps({"verdict": "allow"}), "stderr": msg}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "info":
        out = info()
    elif cmd == "normalize":
        out = normalize(json.load(sys.stdin))
    elif cmd == "respond":
        out = respond(json.load(sys.stdin))
    else:
        print("usage: gitvow-agent-example info|normalize|respond", file=sys.stderr)
        return 1
    json.dump(out, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
